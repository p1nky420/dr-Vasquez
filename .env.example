# ─── Medición: GA4 + Search Console ───────────────────────────────────────
# GA4 es el único canal de analítica del sitio.
# gtag se carga siempre en estado Consent Mode «denied»; los permisos se
# otorgan al aceptar el banner. Sin esta variable no se mide nada.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Clave de Measurement Protocol (GA4 → Administrar → Flujos de datos →
# Secretos de API). Permite registrar la conversión de lead desde el servidor,
# con lo que el conteo de leads no depende del banner ni de bloqueadores.
GA4_API_SECRET=

# Verificación de Google Search Console (método «etiqueta HTML»):
# pega solo el valor del content, no la etiqueta completa.
NEXT_PUBLIC_GSC_VERIFICATION=

# Opcional. Solo si se va a hacer remarketing.
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Anti-spam (opcional) ─────────────────────────────────────────────────
# Si no se configuran, el formulario sigue funcionando sin desafío.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Entrega de leads ─────────────────────────────────────────────────────
# Basta con QUE UNO de estos canales esté configurado para que el formulario
# funcione. Si no hay ninguno, el lead queda solo en el log del servidor y el
# visitante recibe un enlace directo a WhatsApp.

# A) Webhook (lo más rápido de montar: Slack, Make, n8n, Zapier)
INTAKE_NOTIFICATION_WEBHOOK_URL=

# B) Correo vía Resend
RESEND_API_KEY=
INTAKE_NOTIFICATION_EMAIL=contacto@faustovasquezabogados.com
INTAKE_NOTIFICATION_FROM=web@faustovasquezabogados.com

# C) Almacenamiento cifrado (opcional, para archivo histórico)
INTAKE_ENCRYPTION_KEY=
INTAKE_STORAGE_URL=
INTAKE_STORAGE_TOKEN=
